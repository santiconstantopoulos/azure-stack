<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite: base local en un archivo, sin instalar nada (desarrollo) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <!-- SQL Server: lo usaremos dentro de Docker -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <!-- Azure Storage Queues: la API publica eventos que procesa Azure Functions -->
    <PackageReference Include="Azure.Storage.Queues" Version="12.26.0" />
  </ItemGroup>

</Project>
